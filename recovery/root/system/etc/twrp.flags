# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount point          fstype  device                                        device2              flags

/metadata              ext4    /dev/block/bootdevice/by-name/metadata                             flags=display="Metadata";backup=1;wrappedkey;canbewiped=0;wipeingui=0
/data                  f2fs    /dev/block/bootdevice/by-name/userdata                             flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/cache                 ext4    /dev/block/bootdevice/by-name/rescue                               flags=display="Cache";backup=1;wipeingui;wipeduringfactoryreset
/cust                  ext4    /dev/block/bootdevice/by-name/cust                                 flags=backup=1;display="Cust";flashimg=1;canbewiped=0;wipeingui=0
/storage               f2fs    /data/media/0                                                      flags=backup=1;display="Internal Storage";usermrf;fsflags="bind,utf8";removable


# Logical (Super) partitions
# mi_ext is only listed in recovery.fstab (nofail); it is declared here as a
# logical partition so that the high-speed flash path can resolve
# /mi_ext and refresh its size after the Super group rebuild.
/mi_ext                emmc    /dev/block/bootdevice/by-name/mi_ext                               flags=display="mi_ext";logical

# Boot
/boot                  	emmc    /dev/block/bootdevice/by-name/boot                                 flags=backup=1;slotselect;flashimg=1;wipeingui=1
/dtbo                  	emmc    /dev/block/bootdevice/by-name/dtbo                                 flags=backup=1;display="Dtbo";slotselect;flashimg=1;wipeingui=1
/vendor_boot           	emmc    /dev/block/bootdevice/by-name/vendor_boot                          flags=backup=1;display="vendor_boot";slotselect;flashimg=1;wipeingui=1
/exaid                 	emmc    /dev/block/bootdevice/by-name/exaid                                flags=backup=1;display="exaid";flashimg=1;wipeingui=1
/vbmeta                	emmc    /dev/block/bootdevice/by-name/vbmeta                               flags=backup=1;display="vbmeta";slotselect;flashimg=1;wipeingui=1
/vbmeta                 emmc    /dev/block/bootdevice/by-name/vbmeta flags=backup=0;display="vbmeta";flashimg=1;slotselect
/vbmeta_system          emmc   /dev/block/bootdevice/by-name/vbmeta_system flags=backup=1;display="vbmeta_system";flashimg=1;slotselect;wipeingui=1
/vbmeta_vendor         	emmc    /dev/block/bootdevice/by-name/vbmeta_vendor                        flags=backup=1;display="vbmeta_vendor";slotselect;flashimg=1;wipeingui=1
/logo                  	emmc    /dev/block/bootdevice/by-name/logo                                 flags=backup=1;display="logo";flashimg=1;wipeingui=1
/misc                  	emmc    /dev/block/bootdevice/by-name/misc                                 flags=backup=1;display="misc";flashimg=1;wipeingui=1

# Images
/super          	 emmc    	/dev/block/platform/bootdevice/by-name/super            flags=backup=1;display="Super_image";flashimg=1;wipeingui=1
/system_image	    emmc  	/dev/block/mapper/system                flags=backup=1;flashimg=1;display="System Image";wipeingui=1;slotselect
/system     		     ext4	     /dev/block/mapper/system 
/vendor_image	    emmc  	/dev/block/mapper/vendor                flags=backup=1;flashimg=1;display="Vendor Image";wipeingui=1;slotselect
/vendor              ext4      /dev/block/mapper/vendor 
/product_image	    emmc  	/dev/block/mapper/product               flags=backup=1;flashimg=1;display="Product Image";wipeingui=1;slotselect
/product             ext4      /dev/block/mapper/product
/system_ext_image	    emmc  	/dev/block/mapper/system_ext              flags=backup=1;flashimg=1;display="System_ext Image";wipeingui=1;slotselect
/system_ext            ext4      /dev/block/mapper/system_ext
/splash                  	ext4    /dev/block/bootdevice/by-name/splash                                 flags=backup=1;display="Splash";flashimg=1;wipeingui=1
/abl                  	ext4    /dev/block/bootdevice/by-name/abl                                 flags=backup=1;display="Abl";flashimg=1;wipeingui=1
/featenabler                  	ext4    /dev/block/bootdevice/by-name/featenabler                                flags=backup=1;display="Featenabler";flashimg=1;wipeingui=1

# Persistent Firmware & Properties
/persist               	ext4    /dev/block/bootdevice/by-name/persist                              flags=display="Persist"
/persist_image         	emmc    /dev/block/bootdevice/by-name/persist                              flags=display="Persist";flashimg=1;wipeingui=1

# userdata
/userdata_default             emmc           /dev/block/bootdevice/by-name/userdata                     flags=display="Userdata default";flashimg;backup=1;wipeingui

# Firmware partitions
/bluetooth             	vfat    /dev/block/bootdevice/by-name/bluetooth                            flags=display="bluetooth";slotselect;fsflags="ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait"
/bluetooth_image       	emmc    /dev/block/bootdevice/by-name/bluetooth                            flags=backup=1;display="bluetooth";slotselect;backup=1;flashimg=1;wipeingui=1
/dsp                   	vfat    /dev/block/bootdevice/by-name/dsp                                  flags=display="dsp";slotselect
/dsp_image             	emmc    /dev/block/bootdevice/by-name/dsp                                  flags=backup=1;display="dsp";slotselect;flashimg=1;wipeingui=1
/modem                 	vfat    /dev/block/bootdevice/by-name/modem                                flags=display="Modem";slotselect;fsflags="ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0 wait"
/modem_img             	emmc    /dev/block/bootdevice/by-name/modem                                flags=backup=1;display="Modem";slotselect;flashimg=1;wipeingui=1
/efs1                  	emmc    /dev/block/bootdevice/by-name/modemst1                             flags=backup=1;display=EFS
/efs2                  	emmc    /dev/block/bootdevice/by-name/modemst2                             flags=backup=1;subpartitionof=/efs1
/efsc                  	emmc    /dev/block/bootdevice/by-name/fsc                                  flags=backup=1;subpartitionof=/efs1
/efsg                  	emmc    /dev/block/bootdevice/by-name/fsg                                  flags=backup=1;subpartitionof=/efs1

/firmware      vfat    /dev/block/bootdevice/by-name/modem                       flags=display="Firmware";slotselect;backup=0;canbewiped=0;wipeingui=0
/misc          emmc    /dev/block/bootdevice/by-name/misc
/modem         emmc    /dev/block/bootdevice/by-name/modem                       flags=backup=0;display="Modem";slotselect
/bluetooth     emmc    /dev/block/bootdevice/by-name/bluetooth                   flags=backup=0;subpartitionof=/modem;slotselect
/dsp           emmc    /dev/block/bootdevice/by-name/dsp                         flags=backup=0;subpartitionof=/modem;slotselect
/efs1          emmc    /dev/block/bootdevice/by-name/modemst1                    flags=backup=0;display=EFS
/efs2          emmc    /dev/block/bootdevice/by-name/modemst2                    flags=backup=0;subpartitionof=/efs1
/efsc          emmc    /dev/block/bootdevice/by-name/fsc                         flags=backup=0;subpartitionof=/efs1
/efsg          emmc    /dev/block/bootdevice/by-name/fsg                         flags=backup=0;subpartitionof=/efs1
/persist       ext4    /dev/block/bootdevice/by-name/persist                     flags=display="Persist";canbewiped=0;wipeingui=0
/persist_image emmc    /dev/block/bootdevice/by-name/persist                     flags=display="Persist";flashimg=0;backup=0

# Removable storage
/usb_otg       		vfat    /dev/block/sdg1                    /dev/block/sdg         	   flags=fsflags=utf8;display="USB-Storage";storage;wipeingui;removable

# Removable storage
/usb_otg               auto    /dev/block/sdg1                            /dev/block/sdg4         flags=fsflags=utf8;display="USB-OTG";storage;wipeingui;removable
